# Server
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Long random string used to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# From your Stripe Dashboard > Developers > API keys (use the *secret* key)
STRIPE_SECRET_KEY=sk_test_...

# From your Stripe Dashboard > Developers > Webhooks > (your endpoint) > Signing secret
# When testing locally with the Stripe CLI, use the secret it prints from `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (not Product IDs) for your two recurring plans.
# Create these in Stripe Dashboard > Product catalog > + Add product.
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...

# Optional. Where the JSON database and uploaded photos are stored.
# Leave unset for local development (defaults to ./data).
# In production, set this to your host's persistent disk mount path.
DATA_DIR=

# Optional. Powers outgoing email (currently just "forgot password" links).
# From https://resend.com > API Keys. Leave unset and the app still works —
# reset links just get logged to the server console instead of emailed,
# which is fine for local dev/testing but not for real users.
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account.
RESEND_FROM=Fleet Priority <onboarding@resend.dev>
